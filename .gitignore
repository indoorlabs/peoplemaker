node_modules
dist
.env
.env.*
# 진짜 클립은 무겁고, 재배포가 금지된 것도 있다 (Mixamo). 팩은 카탈로그
# (계약)만 저장소에 두고 GLB 는 따로 배포한다 — 무엇을 뒀는지는
# catalog.json 이 말한다.
packs/*/clips/*.glb

# **기준 팩은 뺀다.** 우리가 함수로 만든 CC0 이고 다섯 개에 70KB 다.
# 저장소에 없으면 `npm i github:indoorlabs/peoplemaker` 로 받은 쪽에
# 카탈로그만 가고 클립이 없다 — 실제로 그렇게 깨졌다.
!packs/ref-synthetic/clips/*.glb
# 파이썬 파이프라인 (P2~)
__pycache__
*.pyc
.venv

# Rocketbox 등 원본 자산 캐시 — import 스크립트가 받아 두는 곳. 저장소에 안 올린다.
packs/.cache/
# Rocketbox 팩 — scripts/import-rocketbox.mjs 로 다시 만든다. 클립 GLB 는 원래 무시되므로
# 설명 파일만 올리면 CI 가 클립이 없다고 실패한다.
packs/rocketbox-*/

# 내보낸 팩 — scripts/build-dist.mjs 가 만든다. 올리는 것은 사람이 정한다.
dist/
