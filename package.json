{
  "name": "peoplemaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "공간에 사람을 넣는다 — spacemaker/urbanspace 가 함께 쓰는 사람 층",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indoorlabs/peoplemaker.git"
  },
  "exports": {
    ".": "./src/web/index.mjs",
    "./lib": "./src/lib/index.mjs",
    "./packs/*": "./packs/*",
    "./package.json": "./package.json",
    "./profiles/*": "./profiles/*"
  },
  "files": [
    "src",
    "packs",
    "profiles",
    "docs",
    "README.md",
    "agents.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:anthropometry": "node scripts/check-anthropometry.mjs",
    "check:surface": "node scripts/check-surface.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "build:fixture": "node scripts/make-fixture-pack.mjs && node scripts/build-pack.mjs ref-synthetic",
    "measure:crowd": "node --expose-gc scripts/measure-crowd.mjs",
    "smoke": "node scripts/smoke-consumer.mjs",
    "build:sheet": "node scripts/build-sheet.mjs",
    "build:attributions": "node scripts/build-attributions.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "fetch:packs": "node scripts/fetch-packs.mjs"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "fbx2gltf": "^0.9.7-p1",
    "three": "^0.186.0"
  }
}
